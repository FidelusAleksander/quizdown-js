{
    "compilerOptions": {
        "moduleResolution": "node",
        "target": "ES2019",
        "module": "ESNext",
        "lib": ["ES2019", "DOM", "DOM.Iterable"],
        "strict": false,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": false,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules/*", "public/*", "docs/*"]
}
